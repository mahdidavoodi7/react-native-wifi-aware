{
  "name": "react-native-wifi-aware",
  "version": "0.1.0",
  "description": "Peer-to-peer discovery and high-bandwidth local data paths over Wi-Fi Aware (NAN).",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-wifi-aware-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "plugin/build",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-wifi-aware-example",
    "clean": "del-cli lib plugin/build",
    "prepare": "bob build && yarn build:plugin",
    "nitrogen": "nitrogen",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p plugin --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "build:plugin": "tsc --build plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "android",
    "wifi-aware",
    "wi-fi-aware",
    "nan",
    "neighbor-awareness-networking",
    "wifiawaremanager",
    "peer-to-peer",
    "p2p",
    "device-to-device",
    "offline",
    "local-network",
    "file-transfer",
    "nearby",
    "nitro",
    "nitro-modules",
    "expo-config-plugin",
    "ios26"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdidavoodi7/react-native-wifi-aware.git"
  },
  "author": "Mehdi <mahdidavoodi7@gmail.com> (https://github.com/mahdidavoodi7)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mahdidavoodi7/react-native-wifi-aware/issues"
  },
  "homepage": "https://github.com/mahdidavoodi7/react-native-wifi-aware#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "^54.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "nitrogen": "0.37.1",
    "prettier": "^3.8.3",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "0.37.1",
    "ts-jest": "^29.2.5",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.1"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/plugin/src/**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^react-native-nitro-modules$": "<rootDir>/src/__mocks__/react-native-nitro-modules.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    }
  }
}
